{
  "site": {
    "name": "示例官网",
    "ssg": "next-static",
    "contentDir": "content",
    "buildCmd": "npm run build",
    "outputDir": "out",
    "staticExport": true,
    "template": {
      "source": "htmlrev",
      "name": "所选模板名",
      "url": "https://htmlrev.com/模板地址",
      "selectedAt": "2026-10-21"
    }
  },
  "git": {
    "repo": "git@github.com:org/site.git",
    "localPath": ".",
    "branch": "main"
  },
  "knowledgeBases": [
    {
      "id": "kb1",
      "type": "tencent-docs",
      "name": "产品知识库",
      "inbox": ".geo-cms/inbox/kb1",
      "format": "md"
    },
    {
      "id": "kb2",
      "type": "feishu",
      "name": "帮助文档库",
      "inbox": ".geo-cms/inbox/kb2",
      "format": "md"
    }
  ],
  "deployment": {
    "type": "edgeone-pages",
    "project": "my-official-site",
    "distDir": "out"
  },
  "capabilities": {
    "kb-export":     {"resolved": "tencent-docs", "mode": "connector"},
    "geo-optimize":  {"resolved": "geo-zh",       "mode": "skill"},
    "deploy":        {"resolved": "edgeone-pages","mode": "connector"},
    "browser-verify":{"resolved": "agent-browser","mode": "skill"}
  },
  "specs": {
    "dir": ".geo-cms/specs",
    "lastUpdated": null
  }
}
